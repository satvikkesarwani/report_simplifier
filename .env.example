# Application
APP_NAME="RAG Medical Report Simplifier"
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./medical_reports.db
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_reports

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# OCR
TESSERACT_CMD=
OCR_DPI=300

# NVIDIA LLM (REQUIRED)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FALLBACK_MODEL=mistralai/mistral-7b-instruct-v0.3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=
TOP_K_RETRIEVAL=3
SIMILARITY_THRESHOLD=0.75

# NLP
SPACY_MODEL_PATH=

# Security
AUTH_ENABLED=false
APP_API_TOKEN=
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
